{
  "//": "CUDA OOM when generating 1000+ game decisions. Scaled per model.",
  "model": "gemma2_9b",
  "out_dir": "runs/rlhf_break",
  "gen_batch_size": 32,
  "games": {
    "n_per_game": 50,
    "seed": 0,
    "total": 100
  },
  "decoding": {
    "//": "Higher temperature = more sensitive to steering. T=1.0 lets small logit shifts flip decisions.",
    "greedy": false,
    "temperature": 0.75,
    "top_p": 0.95,
    "n_repeats": 5
  },
  "direction_extraction": {
    "layer_fractions": [
      0.25,
      0.4,
      0.5,
      0.6,
      0.7,
      0.8,
      0.9
    ],
    "n_per_game_aggression": 24,
    "use_game_context_refusal": true,
    "n_game_context_prompts": 30
  },
  "sweep": {
    "//": "Gemma models need this (large RMSNorm residuals); absolute coeff<=20 is invisible.",
    "coeffs": [
      3.0,
      5.0,
      8.0,
      10.0,
      12.0,
      15.0,
      20.0
    ],
    "norm_scale": true,
    "n_per_game": 12,
    "seed": 1,
    "multi_layer_groups": [
      [
        16,
        21,
        25,
        29
      ],
      [
        10,
        16,
        21,
        25,
        29,
        33
      ]
    ],
    "multi_layer_full_coeff": true
  },
  "final_eval": {
    "n_per_game": 50,
    "seed": 42,
    "n_repeats": 5
  },
  "sae": {
    "enabled": true,
    "layer": "auto",
    "d_hidden": 16384,
    "k": 64,
    "top_features": 16,
    "n_prompts": 200,
    "epochs": 500
  },
  "coherence_threshold": 0.7,
  "significance_alpha": 0.05,
  "paired_test": true}
